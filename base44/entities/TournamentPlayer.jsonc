{
  "name": "TournamentPlayer",
  "type": "object",
  "properties": {
    "tournamentId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "seed": {
      "type": "number",
      "default": 0
    },
    "group": {
      "type": "string",
      "default": ""
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "tournamentId",
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}