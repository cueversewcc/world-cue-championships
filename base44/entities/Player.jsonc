{
  "name": "Player",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "group": {
      "type": "string",
      "enum": [
        "A",
        "B"
      ]
    },
    "played": {
      "type": "number",
      "default": 0
    },
    "wins": {
      "type": "number",
      "default": 0
    },
    "losses": {
      "type": "number",
      "default": 0
    },
    "frames_for": {
      "type": "number",
      "default": 0
    },
    "frames_against": {
      "type": "number",
      "default": 0
    },
    "points": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "group"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}