{
  "name": "PlayoffMatch",
  "type": "object",
  "properties": {
    "bracket": {
      "type": "string",
      "enum": [
        "main",
        "consolation"
      ],
      "default": "main"
    },
    "round": {
      "type": "string"
    },
    "slot": {
      "type": "number"
    },
    "player1": {
      "type": "string",
      "default": ""
    },
    "player2": {
      "type": "string",
      "default": ""
    },
    "score1": {
      "type": "number",
      "default": 0
    },
    "score2": {
      "type": "number",
      "default": 0
    },
    "winner": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "round",
    "slot"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}